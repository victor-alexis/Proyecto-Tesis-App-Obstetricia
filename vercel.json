{
  "version": 2,
  "buildCommand": "cd app_movil && npm install && npx expo export --platform web",
  "outputDirectory": "app_movil/dist",
  "functions": {
    "backend/src/index.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "app_movil/dist/$1"
    }
  ]
}

