{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "app_movil/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/_expo/(.*)",
      "dest": "app_movil/_expo/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "app_movil/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "app_movil/favicon.ico"
    },
    {
      "src": "/login",
      "dest": "app_movil/login.html"
    },
    {
      "src": "/explore",
      "dest": "app_movil/explore.html"
    },
    {
      "src": "/(.*)",
      "dest": "app_movil/index.html"
    }
  ]
}

